{
  "expo": {
    "name": "TOGETHER",
    "slug": "together",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "together",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A1C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mn.together.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "mn.together.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A1C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Group-тэйгээ зураг, слайд хуваалцахад зургийн санг ашиглана.",
          "cameraPermission": "Чатад зураг, видео авахад камер хэрэгтэй.",
          "microphonePermission": "Видео бичихэд микрофон хэрэгтэй."
        }
      ],
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Дуут мессеж бичихэд микрофон хэрэгтэй."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Гүйлт, алхалт, байршлын challenge-ийг утас түгжээтэй үед ч баталгаажуулахад байршил хэрэгтэй.",
          "locationWhenInUsePermission": "Гүйлт, алхалт, байршлын challenge-ийг баталгаажуулахад байршил хэрэгтэй.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TOGETHER нэвтрэхэд Face ID ашиглана."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
