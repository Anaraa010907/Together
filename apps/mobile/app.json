{
  "expo": {
    "name": "TOGETHER",
    "slug": "together",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "together",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A1C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mn.together.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "mn.together.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A1C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Group-\u0442\u044d\u0439\u0433\u044d\u044d \u0437\u0443\u0440\u0430\u0433, \u0441\u043b\u0430\u0439\u0434 \u0445\u0443\u0432\u0430\u0430\u043b\u0446\u0430\u0445\u0430\u0434 \u0437\u0443\u0440\u0433\u0438\u0439\u043d \u0441\u0430\u043d\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
