{
  "expo": {
    "name": "TOGETHER",
    "slug": "together",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "together",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0E7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mn.together.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "mn.together.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111923"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Group-тэйгээ зураг, слайд хуваалцахад зургийн санг ашиглана."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
